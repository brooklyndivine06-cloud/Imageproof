# ImageProof API configuration. Copy to `.env` (never commit it) and adjust.
# Every variable is prefixed with IMAGEPROOF_.

# --- General ---------------------------------------------------------------------
IMAGEPROOF_ENVIRONMENT=development          # development | production | test (production disables /docs)
IMAGEPROOF_LOG_LEVEL=INFO
# Browser origins allowed to call the API directly (comma separated, no "*").
# Leave empty when the Next.js frontend proxies requests (default setup).
IMAGEPROOF_CORS_ORIGINS=
# How many reverse proxies in front of the API append to X-Forwarded-For (0 = use socket address).
IMAGEPROOF_TRUSTED_PROXY_COUNT=0

# --- Upload limits -----------------------------------------------------------------
IMAGEPROOF_MAX_UPLOAD_MB=10
IMAGEPROOF_MIN_IMAGE_SIDE=64
IMAGEPROOF_MAX_IMAGE_PIXELS=40000000        # 40 megapixels
IMAGEPROOF_ANALYSIS_TIMEOUT_SECONDS=60
IMAGEPROOF_MAX_CONCURRENT_ANALYSES=2
IMAGEPROOF_QUEUE_WAIT_SECONDS=5

# --- Rate limiting (per client IP, per process) -----------------------------------------
IMAGEPROOF_RATE_LIMIT_REQUESTS=20
IMAGEPROOF_RATE_LIMIT_WINDOW_SECONDS=600

# =====================================================================================
# DETECTION MODEL
# The application ships WITHOUT a model enabled. Until a provider below is configured,
# /api/v1/status reports ready=false and /api/v1/analyze returns 503 (no result is invented).
# =====================================================================================
IMAGEPROOF_PROVIDER=huggingface_local       # huggingface_local | http_endpoint

# Label mapping is mandatory: say which of the model's labels mean "AI-generated" and which
# mean "real/camera". Check your model's config.json (id2label) and model card.
IMAGEPROOF_AI_LABELS=artificial
IMAGEPROOF_REAL_LABELS=human

# Operator-written text shown to users on the results page. Fill in from the model card.
IMAGEPROOF_DETECTOR_LICENSE=
IMAGEPROOF_DETECTOR_DESCRIPTION=

# Decision thresholds on the AI-label score. These defaults are conservative guesses, NOT validated.
# Run `python -m app.evaluation ... --fit-calibration` and set IMAGEPROOF_CALIBRATION_FILE to replace them
# with thresholds measured on your own labelled data.
IMAGEPROOF_AI_THRESHOLD=0.85
IMAGEPROOF_REAL_THRESHOLD=0.15
IMAGEPROOF_DEGRADE_LOW_RELIABILITY=true
IMAGEPROOF_CALIBRATION_FILE=
IMAGEPROOF_EVALUATION_REPORT=

# --- Provider A: self-hosted Hugging Face model (images never leave your server) ----------
# Requires: pip install -r requirements-ml.txt
# STARTER EXAMPLE (uncomment to try; read the caveats in README "Choosing a detection model"):
#   Organika/sdxl-detector - Swin classifier, labels artificial/human, trained on Stable Diffusion XL
#   images. LICENSE: CC-BY-NC-3.0 (non-commercial only). Not evaluated by ImageProof.
# IMAGEPROOF_HF_MODEL_ID=Organika/sdxl-detector
# IMAGEPROOF_DETECTOR_LICENSE=CC-BY-NC-3.0 (non-commercial)
# Pin an exact commit hash for reproducible results:
IMAGEPROOF_HF_MODEL_REVISION=
IMAGEPROOF_HF_DEVICE=auto                   # auto | cpu | cuda | mps
IMAGEPROOF_HF_PROCESSOR_BACKEND=pil         # pil is portable and needs no torchvision
IMAGEPROOF_HF_LOCAL_FILES_ONLY=false        # true = never contact the Hub (use a pre-downloaded cache)

# --- Provider B: hosted inference endpoint (images ARE sent to that provider) ---------------
# Expects a JSON list of {"label": ..., "score": ...} (Hugging Face image-classification format).
# IMAGEPROOF_PROVIDER=http_endpoint
IMAGEPROOF_HTTP_URL=
IMAGEPROOF_HTTP_API_KEY=                    # server-side only; never exposed to the browser
IMAGEPROOF_HTTP_AUTH_HEADER=Authorization
IMAGEPROOF_HTTP_AUTH_SCHEME=Bearer
IMAGEPROOF_HTTP_PAYLOAD=pixels_png          # pixels_png (strips EXIF/GPS) | original
IMAGEPROOF_HTTP_TIMEOUT_SECONDS=30
IMAGEPROOF_HTTP_MODEL_NAME=
IMAGEPROOF_HTTP_MODEL_VERSION=

# --- Evidence modules ---------------------------------------------------------------------
IMAGEPROOF_ENABLE_PROVENANCE=true
IMAGEPROOF_ENABLE_FORENSICS=true
