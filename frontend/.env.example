# Frontend runtime configuration (server-side only; nothing here is exposed to the browser).
# URL of the ImageProof FastAPI backend. The Next.js server proxies /api/v1/* to it at request time.
BACKEND_URL=http://127.0.0.1:8000
# Must match IMAGEPROOF_MAX_UPLOAD_MB on the backend. The proxy uses it to refuse oversized uploads early.
MAX_UPLOAD_MB=10
